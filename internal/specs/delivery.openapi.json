{
  "openapi": "3.1.0",
  "info": {
    "title": "DAS Delivery API",
    "version": "0.1.0",
    "description": "DAS Delivery for one Network: line items (orders, creatives, deals, inventory and reports follow). Served on the Network host `<network>.delivery.<org domain>`. Conventions (docs/engineering/api-conventions.md): JSON in camelCase, instants in `*At` fields as ISO-8601 UTC, ids as prefixed ULIDs, money as the Money object in the Network's currency. Errors are RFC 7807 `application/problem+json` with a machine `code`. Every mutation requires an `Idempotency-Key`. Authentication is an Organization session token bound to a Network; the Network a request acts for is ALWAYS the credential's, and the host must name it (403 `NETWORK_HOST_MISMATCH`). 401 and 403 problems apply to every authenticated operation; 503 `UPSTREAM_UNAVAILABLE` when the Organisation API, which answers for the credential's Network, does not."
  },
  "x-das-module": "delivery",
  "x-das-product": "delivery",
  "x-das-terraform": {
    "resources": [
      {
        "name": "lineitem",
        "description": "A line item of the credential's Network: what to serve, when and for which budget. It starts as `DRAFT`. The API has no update and no delete yet (a line item is archived, never deleted): a change is refused at plan, and destroy only forgets it.",
        "create": "POST /api/lineitems",
        "read": "GET /api/lineitems/{lineitemId}",
        "list": "GET /api/lineitems",
        "example": {
          "name": "Homepage takeover, January",
          "type": "STANDARD",
          "priority": 8,
          "startAt": "2027-01-01T00:00:00Z",
          "endAt": "2027-01-31T23:59:59Z",
          "budget": {
            "amount": "15000.00",
            "currency": "PLN"
          },
          "pacing": "EVEN"
        },
        "destroy": {
          "via": "forget",
          "reason": "A line item is archivable (P11): it is never deleted, and the API has no archive operation yet."
        }
      }
    ],
    "dataSources": [
      {
        "name": "session",
        "description": "Who the credential is in DAS Delivery for its Network.",
        "read": "GET /api/session"
      },
      {
        "name": "lineitem_summary",
        "description": "The summary of the Network's line items (the feature `lineitem-summary`).",
        "read": "GET /api/lineitem-summary"
      }
    ],
    "actions": [],
    "ephemeralResources": []
  },
  "servers": [
    {
      "url": "/",
      "description": "A Network host of the delivery module, `<network>.delivery.<org domain>`"
    }
  ],
  "tags": [
    {
      "name": "meta",
      "description": "Health and the contract"
    },
    {
      "name": "session",
      "description": "The credential and its Network"
    },
    {
      "name": "lineitems",
      "description": "Line items: what to serve, when and how fast"
    },
    {
      "name": "lineitem-summary",
      "description": "Feature lineitem-summary: the line items at a glance"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "An Organization session token (Cognito access token) bound to one Network."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Client-chosen key, 1-255 printable ASCII characters (a UUID is fine). A retry with the same key and request replays the first response; the same key with a different request is 409 `IDEMPOTENCY_CONFLICT`.",
        "schema": {
          "type": "string",
          "pattern": "^[\\x21-\\x7E]{1,255}$"
        }
      },
      "RequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "description": "Correlation id, 1-128 characters of `A-Z a-z 0-9 . _ : -`; echoed in the response. A malformed or missing one is replaced by `req_<ULID>`.",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Page size, 1-100 (default 50).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "The `nextCursor` of the previous page, passed back unchanged. Omit it for the first page.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "LineitemIdPath": {
        "name": "lineitemId",
        "in": "path",
        "required": true,
        "description": "The line item, `li_<ULID>`. One of another Network is 404 `NOT_FOUND`.",
        "schema": {
          "type": "string",
          "pattern": "^li_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      },
      "StatusFilter": {
        "name": "status",
        "in": "query",
        "required": false,
        "description": "Only line items in this lifecycle status.",
        "schema": {
          "type": "string",
          "enum": [
            "DRAFT",
            "PENDING_APPROVAL",
            "REJECTED",
            "SCHEDULED",
            "LIVE",
            "PAUSED",
            "ENDED",
            "ARCHIVED"
          ]
        }
      }
    },
    "headers": {
      "XRequestId": {
        "description": "The request id: the client's well-formed X-Request-Id, else a generated `req_<ULID>`.",
        "schema": {
          "type": "string"
        }
      },
      "IdempotentReplayed": {
        "description": "`true` when the response is the stored response of an earlier request with the same Idempotency-Key.",
        "schema": {
          "type": "string",
          "enum": [
            "true"
          ]
        }
      }
    },
    "responses": {
      "ValidationFailed": {
        "description": "The request is not valid (`VALIDATION_FAILED`, `MALFORMED_JSON`, `INVALID_CURSOR`, `IDEMPOTENCY_KEY_REQUIRED`, `IDEMPOTENCY_KEY_INVALID`)",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "No valid credential (`UNAUTHENTICATED`, `INVALID_CREDENTIAL`, `CREDENTIAL_REVOKED`)",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The credential may not do this (`NO_ACCESS`, `INSUFFICIENT_ROLE`, `INSUFFICIENT_SCOPE`, `NETWORK_CREDENTIAL_REQUIRED`, `NETWORK_HOST_MISMATCH`, `FEATURE_DISABLED`)",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found (`NOT_FOUND`)",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict (`IDEMPOTENCY_CONFLICT`)",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "The request body is not `application/json` (`UNSUPPORTED_MEDIA_TYPE`)",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "UpstreamUnavailable": {
        "description": "The Organisation API did not answer for the credential's Network (`UPSTREAM_UNAVAILABLE`)",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InternalError": {
        "description": "An unexpected failure (`INTERNAL_ERROR`); the request id names it in the service's logs",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "format": "decimal",
            "description": "Decimal string, e.g. \"1250.00\""
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO-4217 code, upper-case"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "additionalProperties": false,
        "description": "An amount of money: a decimal string (never a JSON number) and its ISO-4217 currency."
      },
      "LineitemCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Name, 1-200 characters"
          },
          "type": {
            "type": "string",
            "enum": [
              "STANDARD",
              "SPONSORSHIP",
              "HOUSE"
            ],
            "description": "Guaranteed volume, a share of voice, or house inventory"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "description": "Serving priority, 1 (highest) to 16"
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "Start of the flight, an ISO-8601 instant"
          },
          "endAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "End of the flight, an ISO-8601 instant after startAt"
          },
          "budget": {
            "description": "Budget, not negative, in the Network's currency (`defaultCurrency` of GET /api/session)",
            "$ref": "#/components/schemas/Money"
          },
          "pacing": {
            "type": "string",
            "enum": [
              "EVEN",
              "ASAP",
              "FRONT_LOADED"
            ],
            "description": "How delivery is spread over the flight"
          }
        },
        "required": [
          "name",
          "type",
          "priority",
          "startAt",
          "endAt",
          "budget",
          "pacing"
        ],
        "additionalProperties": false,
        "description": "A new line item. It starts as `DRAFT`; its budget is in the Network's currency."
      },
      "Problem": {
        "type": "object",
        "description": "RFC 7807 problem details. Branch on `code`, never on `title` or `detail`.",
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "code",
          "requestId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "`urn:das:problem:<code>`"
          },
          "title": {
            "type": "string",
            "description": "Short summary of the problem type"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code"
          },
          "detail": {
            "type": "string",
            "description": "Explanation of this occurrence"
          },
          "instance": {
            "type": "string",
            "description": "The request path"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "MALFORMED_JSON",
              "INVALID_CURSOR",
              "IDEMPOTENCY_KEY_REQUIRED",
              "IDEMPOTENCY_KEY_INVALID",
              "UNAUTHENTICATED",
              "INVALID_CREDENTIAL",
              "CREDENTIAL_REVOKED",
              "CREDENTIAL_EXPIRED",
              "NO_ACCESS",
              "INSUFFICIENT_ROLE",
              "INSUFFICIENT_SCOPE",
              "ORG_CREDENTIAL_REQUIRED",
              "NETWORK_CREDENTIAL_REQUIRED",
              "NETWORK_HOST_MISMATCH",
              "FEATURE_DISABLED",
              "NOT_FOUND",
              "PATH_NOT_CANONICAL",
              "IDEMPOTENCY_CONFLICT",
              "SLUG_TAKEN",
              "NETWORK_CODE_TAKEN",
              "ALREADY_EXISTS",
              "LAST_OWNER",
              "IN_USE",
              "IDENTITY_PROVIDER_EXISTS",
              "LOCKOUT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "EMAIL_REJECTED",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "UPSTREAM_UNAVAILABLE",
              "NOT_CONFIGURED"
            ],
            "description": "Machine-readable problem code"
          },
          "requestId": {
            "type": "string",
            "description": "The request id (X-Request-Id)"
          },
          "errors": {
            "type": "array",
            "description": "Field errors of a `VALIDATION_FAILED` problem",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            }
          }
        }
      },
      "ProblemFieldError": {
        "type": "object",
        "description": "One invalid value",
        "required": [
          "location",
          "path",
          "message"
        ],
        "properties": {
          "location": {
            "type": "string",
            "enum": [
              "BODY",
              "QUERY",
              "PATH",
              "HEADER"
            ],
            "description": "Where the value was sent"
          },
          "path": {
            "type": "string",
            "description": "Dotted path inside the location; empty for the whole value"
          },
          "message": {
            "type": "string",
            "description": "What is wrong"
          }
        }
      },
      "NextCursor": {
        "type": [
          "string",
          "null"
        ],
        "description": "Cursor of the next page, opaque; null on the last page."
      },
      "Health": {
        "type": "object",
        "description": "Liveness of the process",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OK"
            ],
            "description": "Always `OK` when the process serves requests"
          }
        }
      },
      "Session": {
        "type": "object",
        "description": "The credential, the Network it acts for, the features effectively on for that Network and the Networks it may switch to.",
        "required": [
          "actor",
          "role",
          "roles",
          "scopes",
          "network",
          "features",
          "networks",
          "accent"
        ],
        "properties": {
          "features": {
            "type": "array",
            "description": "Ids of the features effectively on for the Network (the UI shows what they own); switched in the Organisation API",
            "items": {
              "type": "string"
            }
          },
          "actor": {
            "type": "string",
            "description": "Audit-grammar actor, `human:<email>`"
          },
          "role": {
            "type": "string",
            "enum": [
              "VIEWER",
              "OPERATOR",
              "ADMIN"
            ],
            "description": "Coarse role of the credential"
          },
          "roles": {
            "type": "array",
            "description": "The Network roles the credential's Network token carries (GET /api/roles of the Organisation API describes each); empty for other credentials",
            "items": {
              "type": "string"
            }
          },
          "scopes": {
            "type": "array",
            "description": "Scopes `das:<product>:<resource>:<action>`",
            "items": {
              "type": "string"
            }
          },
          "network": {
            "$ref": "#/components/schemas/SessionNetwork"
          },
          "networks": {
            "type": "array",
            "description": "The Organization's Networks the UI's switcher offers, by display name; switching navigates to that Network's host and signs in there",
            "items": {
              "$ref": "#/components/schemas/SwitchableNetwork"
            }
          },
          "accent": {
            "$ref": "#/components/schemas/SessionAccent"
          }
        }
      },
      "SessionAccent": {
        "type": "object",
        "description": "The accent of the Delivery interface for the Network (the setting `delivery.accent-color`).",
        "required": [
          "color",
          "source"
        ],
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^#[0-9a-f]{6}$",
            "description": "`#rrggbb`; null = the DAS default. The UI derives it for both themes and keeps the default when it misses WCAG AA"
          },
          "source": {
            "type": "string",
            "enum": [
              "NETWORK",
              "ORGANIZATION",
              "DEFAULT"
            ],
            "description": "Where it comes from: the Network's own value, the Organization's, or the built-in default"
          }
        }
      },
      "SwitchableNetwork": {
        "type": "object",
        "description": "A Network of the Organization the session may switch to.",
        "required": [
          "slug",
          "displayName",
          "networkCode"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "description": "Host label of the Network: `<slug>.delivery.<org domain>`"
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable name"
          },
          "networkCode": {
            "type": "string",
            "pattern": "^NT-[0-9]{7}$",
            "description": "The number people use for the Network, `NT-` and seven digits"
          }
        }
      },
      "SessionNetwork": {
        "type": "object",
        "description": "The credential's Network, as the Organisation API records it.",
        "required": [
          "id",
          "slug",
          "displayName",
          "networkCode",
          "timezone",
          "defaultCurrency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^net_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "description": "Network id, `net_<ULID>`"
          },
          "slug": {
            "type": "string",
            "description": "Host label of the Network"
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable name"
          },
          "networkCode": {
            "type": "string",
            "pattern": "^NT-[0-9]{7}$",
            "description": "The number people use for the Network, `NT-` and seven digits"
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone where the Network's days begin; dates are shown in it"
          },
          "defaultCurrency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO-4217 code of the Network's money"
          }
        }
      },
      "Lineitem": {
        "type": "object",
        "description": "A deliverable line of a deal: what to serve, when and how fast.",
        "required": [
          "id",
          "name",
          "status",
          "type",
          "priority",
          "startAt",
          "endAt",
          "budget",
          "pacing",
          "createdAt",
          "updatedAt",
          "archivedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^li_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "description": "Line item id, `li_<ULID>`"
          },
          "name": {
            "type": "string",
            "description": "Name, shown in lists and reports"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_APPROVAL",
              "REJECTED",
              "SCHEDULED",
              "LIVE",
              "PAUSED",
              "ENDED",
              "ARCHIVED"
            ],
            "description": "Lifecycle status; a new line item is `DRAFT`"
          },
          "type": {
            "type": "string",
            "enum": [
              "STANDARD",
              "SPONSORSHIP",
              "HOUSE"
            ],
            "description": "Guaranteed volume, a share of voice, or house inventory"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "description": "Serving priority, 1 (highest) to 16"
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the flight, ISO-8601 UTC"
          },
          "endAt": {
            "type": "string",
            "format": "date-time",
            "description": "End of the flight, ISO-8601 UTC"
          },
          "budget": {
            "$ref": "#/components/schemas/Money",
            "description": "Budget of the flight, in the Network's currency"
          },
          "pacing": {
            "type": "string",
            "enum": [
              "EVEN",
              "ASAP",
              "FRONT_LOADED"
            ],
            "description": "How delivery is spread over the flight"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation instant, ISO-8601 UTC"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last change, ISO-8601 UTC"
          },
          "archivedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When it was archived; null while not archived"
          }
        }
      },
      "LineitemSummary": {
        "type": "object",
        "description": "The Network's line items at a glance (feature `lineitem-summary`).",
        "required": [
          "total",
          "byStatus",
          "booked"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "description": "Every line item of the Network, archived ones included"
          },
          "byStatus": {
            "type": "array",
            "description": "How many line items are in each lifecycle status, every status listed",
            "items": {
              "$ref": "#/components/schemas/StatusCount"
            }
          },
          "booked": {
            "$ref": "#/components/schemas/Money",
            "description": "Budget of every line item that is not archived, in the Network's currency"
          }
        }
      },
      "StatusCount": {
        "type": "object",
        "description": "The number of line items in one status.",
        "required": [
          "status",
          "count"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_APPROVAL",
              "REJECTED",
              "SCHEDULED",
              "LIVE",
              "PAUSED",
              "ENDED",
              "ARCHIVED"
            ],
            "description": "Lifecycle status"
          },
          "count": {
            "type": "integer",
            "description": "Line items in it"
          }
        }
      },
      "LineitemPage": {
        "type": "object",
        "description": "One page of line items, ordered by id (creation order).",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "The line items of this page",
            "items": {
              "$ref": "#/components/schemas/Lineitem"
            }
          },
          "nextCursor": {
            "$ref": "#/components/schemas/NextCursor"
          }
        }
      }
    }
