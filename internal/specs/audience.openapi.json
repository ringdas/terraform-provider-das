{
  "openapi": "3.1.0",
  "info": {
    "title": "DAS Audience API",
    "version": "0.0.0",
    "description": "DAS Audience for one Network (audiences and segments follow). Served on the Network host `<network>.audience.<org domain>`. Conventions (docs/engineering/api-conventions.md): JSON in camelCase, instants in `*At` fields as ISO-8601 UTC, ids as prefixed ULIDs. Errors are RFC 7807 `application/problem+json` with a machine `code`. Authentication is an Organization session token bound to a Network; the Network a request acts for is ALWAYS the credential's, and the host must name it (403 `NETWORK_HOST_MISMATCH`). 401 and 403 problems apply to every authenticated operation; 503 `UPSTREAM_UNAVAILABLE` when the Organisation API, which answers for the credential's Network, does not."
  },
  "x-das-module": "audience",
  "x-das-product": "audience",
  "x-das-terraform": {
    "resources": [],
    "dataSources": [
      {
        "name": "session",
        "description": "Who the credential is in DAS Audience for its Network.",
        "read": "GET /api/session"
      },
      {
        "name": "audit_events",
        "description": "The audit trail of the credential's Network in DAS Audience, filtered (every page followed).",
        "read": "GET /api/audit-events"
      },
      {
        "name": "audit_event",
        "description": "One row of the audit trail of the credential's Network in DAS Audience.",
        "read": "GET /api/audit-events/{auditEventId}"
      },
      {
        "name": "audit_chain",
        "description": "The hash chain of the Network's audit trail in DAS Audience: its head and last verification.",
        "read": "GET /api/audit-chain"
      },
      {
        "name": "audit_chain_verification",
        "description": "A verification of a segment of the Network's audit chain in DAS Audience, computed at read.",
        "read": "GET /api/audit-chain/verification"
      }
    ],
    "actions": [],
    "ephemeralResources": []
  },
  "servers": [
    {
      "url": "/",
      "description": "A Network host of the audience module, `<network>.audience.<org domain>`"
    }
  ],
  "tags": [
    {
      "name": "meta",
      "description": "Health and the contract"
    },
    {
      "name": "session",
      "description": "The credential and its Network"
    },
    {
      "name": "audit",
      "description": "The audit trail: who changed what, before and after, its hash chain and export"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "An Organization session token (Cognito access token) bound to one Network."
      }
    },
    "parameters": {
      "AuditActorFilter": {
        "name": "actor",
        "in": "query",
        "required": false,
        "description": "Only rows of this actor, exactly: `human:<email>`, `service:<apiKeyName>` or `agent:<name>/<session>`.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "AuditActionFilter": {
        "name": "action",
        "in": "query",
        "required": false,
        "description": "Only rows of this action, exactly, e.g. `api-key.create`.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "AuditResourceTypeFilter": {
        "name": "resourceType",
        "in": "query",
        "required": false,
        "description": "Only rows about this kind of resource, e.g. `api-key`.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "AuditResourceIdFilter": {
        "name": "resourceId",
        "in": "query",
        "required": false,
        "description": "Only rows about this resource, by its id.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "AuditChannelFilter": {
        "name": "channel",
        "in": "query",
        "required": false,
        "description": "Only rows that came through this channel.",
        "schema": {
          "type": "string",
          "enum": [
            "CONSOLE",
            "CLI",
            "API",
            "AGENT",
            "SCIM",
            "SYSTEM"
          ]
        }
      },
      "AuditFromFilter": {
        "name": "from",
        "in": "query",
        "required": false,
        "description": "Only rows that occurred at or after this ISO-8601 instant.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "AuditToFilter": {
        "name": "to",
        "in": "query",
        "required": false,
        "description": "Only rows that occurred before this ISO-8601 instant.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "AuditExportFrom": {
        "name": "from",
        "in": "query",
        "required": true,
        "description": "The start of the window, an ISO-8601 instant (inclusive).",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "AuditExportTo": {
        "name": "to",
        "in": "query",
        "required": true,
        "description": "The end of the window, an ISO-8601 instant (exclusive), after `from` and at most 92 days later.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "AuditFromSeq": {
        "name": "fromSeq",
        "in": "query",
        "required": false,
        "description": "The first link to verify (default 1, the genesis).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "AuditVerifyLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "How many links to verify, 1-5000 (default 1000).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "default": 1000
        }
      },
      "AuditEventIdPath": {
        "name": "auditEventId",
        "in": "path",
        "required": true,
        "description": "The audit event, `aud_<ULID>`.",
        "schema": {
          "type": "string",
          "pattern": "^aud_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Client-chosen key, 1-255 printable ASCII characters (a UUID is fine). A retry with the same key and request replays the first response; the same key with a different request is 409 `IDEMPOTENCY_CONFLICT`.",
        "schema": {
          "type": "string",
          "pattern": "^[\\x21-\\x7E]{1,255}$"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Page size, 1-100 (default 50).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "The `nextCursor` of the previous page, passed back unchanged. Omit it for the first page.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "RequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "description": "Correlation id, 1-128 characters of `A-Z a-z 0-9 . _ : -`; echoed in the response. A malformed or missing one is replaced by `req_<ULID>`.",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "headers": {
      "XRequestId": {
        "description": "The request id: the client's well-formed X-Request-Id, else a generated `req_<ULID>`.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "ValidationFailed": {
        "description": "The request is not valid (`VALIDATION_FAILED`, `MALFORMED_JSON`, `INVALID_CURSOR`): an unknown query parameter or a malformed value",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found (`NOT_FOUND`)",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "No valid credential (`UNAUTHENTICATED`, `INVALID_CREDENTIAL`, `CREDENTIAL_REVOKED`)",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The credential may not do this (`NO_ACCESS`, `INSUFFICIENT_ROLE`, `INSUFFICIENT_SCOPE`, `NETWORK_CREDENTIAL_REQUIRED`, `NETWORK_HOST_MISMATCH`, `FEATURE_DISABLED`)",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "UpstreamUnavailable": {
        "description": "The Organisation API did not answer for the credential's Network (`UPSTREAM_UNAVAILABLE`)",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InternalError": {
        "description": "An unexpected failure (`INTERNAL_ERROR`); the request id names it in the service's logs",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "format": "decimal",
            "description": "Decimal string, e.g. \"1250.00\""
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO-4217 code, upper-case"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "additionalProperties": false,
        "description": "An amount of money: a decimal string (never a JSON number) and its ISO-4217 currency."
      },
      "AuditEvent": {
        "type": "object",
        "description": "One row of an audit trail: one mutation (or a chain's genesis). Its `hash` is sha256(`prevHash` || RFC 8785 JSON of the record v1: every field here but `hash`, plus `v: 1`), lower-case hex.",
        "required": [
          "id",
          "chain",
          "seq",
          "prevHash",
          "hash",
          "networkId",
          "occurredAt",
          "actor",
          "action",
          "resourceType",
          "resourceId",
          "requestId",
          "reason",
          "changes",
          "channel",
          "actorRole",
          "actorRoles",
          "actorNetworkId",
          "credentialKind",
          "credentialId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The row, `aud_<ULID>` on a Network's trail, `orgaud_<ULID>` on the org layer's"
          },
          "chain": {
            "type": "string",
            "description": "The chain the row is a link of: `org`, or `network:<networkId>`"
          },
          "seq": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Its position in the chain, from 1 (the genesis) without gaps; null for a row written before the chain (sealed by the genesis)"
          },
          "prevHash": {
            "type": [
              "string",
              "null"
            ],
            "description": "The hash of the link before (64 zeros for the genesis); null before the chain",
            "pattern": "^[0-9a-f]{64}$"
          },
          "hash": {
            "type": [
              "string",
              "null"
            ],
            "description": "sha256(prevHash || RFC 8785 JSON of the record), lower-case hex; null before the chain",
            "pattern": "^[0-9a-f]{64}$"
          },
          "networkId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The Network whose trail it is; null on the org layer's",
            "pattern": "^net_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the change committed, ISO-8601 UTC with milliseconds"
          },
          "actor": {
            "type": "string",
            "description": "Who acted: `human:<email>`, `service:<apiKeyName>` or `agent:<name>/<session>`"
          },
          "action": {
            "type": "string",
            "description": "What was done, `<resource>.<verb>`, e.g. `api-key.create`; `audit-chain.genesis` for a chain's first link"
          },
          "resourceType": {
            "type": "string",
            "description": "The kind of resource, e.g. `api-key`"
          },
          "resourceId": {
            "type": "string",
            "description": "The resource's id"
          },
          "requestId": {
            "type": "string",
            "description": "The X-Request-Id of the request that made the change"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why, when the operation records it"
          },
          "changes": {
            "type": [
              "array",
              "null"
            ],
            "description": "What the mutation changed, one entry per row written; null before the chain. Empty for an act that changes no row (a test email)",
            "items": {
              "$ref": "#/components/schemas/AuditChange"
            }
          },
          "channel": {
            "type": [
              "string",
              "null"
            ],
            "description": "The door: the console, the das CLI (its User-Agent, a declaration), an API key, an AI agent, the identity provider over SCIM, or the platform itself",
            "enum": [
              "CONSOLE",
              "CLI",
              "API",
              "AGENT",
              "SCIM",
              "SYSTEM",
              null
            ]
          },
          "actorRole": {
            "type": [
              "string",
              "null"
            ],
            "description": "The coarse role of the principal",
            "enum": [
              "VIEWER",
              "OPERATOR",
              "ADMIN",
              null
            ]
          },
          "actorRoles": {
            "type": "array",
            "description": "The role names the principal held (GET /api/roles of the Organisation API describes each); empty for an API key",
            "items": {
              "type": "string"
            }
          },
          "actorNetworkId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The Network the principal's credential is bound to; null for an Organization-level one"
          },
          "credentialKind": {
            "type": [
              "string",
              "null"
            ],
            "description": "The kind of credential, never its secret",
            "enum": [
              "API_KEY",
              "ORG_API_KEY",
              "COGNITO",
              "NETWORK_SESSION",
              "SCIM_TOKEN",
              null
            ]
          },
          "credentialId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The credential's id: an API key's `key_<ULID>`, an Organization API key's `okey_<ULID>`, a session's subject or token id, a SCIM token's `scimtok_<ULID>`"
          }
        }
      },
      "AuditChange": {
        "type": "object",
        "description": "One row a mutation wrote: its model and id, the operation and the fields that changed.",
        "required": [
          "model",
          "id",
          "op",
          "fields"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "The model (table), e.g. `ApiKey`"
          },
          "id": {
            "type": "string",
            "description": "The row's id"
          },
          "op": {
            "type": "string",
            "enum": [
              "CREATE",
              "UPDATE",
              "DELETE"
            ],
            "description": "What happened to the row"
          },
          "fields": {
            "type": "object",
            "description": "The changed fields by name: `{ before, after }` (a CREATE's before and a DELETE's after are null; instants ISO-8601, decimals as strings), or `{ redacted: true, changed }` for a secret, a hash or a secret reference, whose value is never recorded",
            "additionalProperties": {
              "$ref": "#/components/schemas/AuditFieldChange"
            }
          }
        }
      },
      "AuditFieldChange": {
        "description": "One changed field: its values, or only that a secret changed.",
        "oneOf": [
          {
            "type": "object",
            "description": "The value before and after",
            "required": [
              "before",
              "after"
            ],
            "properties": {
              "before": {
                "description": "The value before; null when the row did not exist"
              },
              "after": {
                "description": "The value after; null when the row is gone"
              }
            }
          },
          {
            "type": "object",
            "description": "A secret, hash or secret reference: only whether it changed",
            "required": [
              "redacted",
              "changed"
            ],
            "properties": {
              "redacted": {
                "type": "boolean",
                "enum": [
                  true
                ],
                "description": "Always true"
              },
              "changed": {
                "type": "boolean",
                "description": "Whether the value changed"
              }
            }
          }
        ]
      },
      "AuditEventPage": {
        "type": "object",
        "description": "One page of an audit trail, newest first.",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "The audit events of this page",
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            }
          },
          "nextCursor": {
            "$ref": "#/components/schemas/NextCursor"
          }
        }
      },
      "AuditChainBreak": {
        "type": "object",
        "description": "The first link that does not hold, and why.",
        "required": [
          "seq",
          "reason"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "description": "The seq where the chain breaks"
          },
          "reason": {
            "type": "string",
            "enum": [
              "HASH_MISMATCH",
              "PREV_HASH_MISMATCH",
              "SEQ_GAP",
              "GENESIS_MISSING",
              "LEGACY_DIGEST_MISMATCH",
              "TRUNCATED"
            ],
            "description": "HASH_MISMATCH: a field changed behind the application; PREV_HASH_MISMATCH: a link does not name the one before; SEQ_GAP: a link was deleted; GENESIS_MISSING: the first link is no genesis; LEGACY_DIGEST_MISMATCH: a row before the chain changed; TRUNCATED: the newest links were deleted"
          }
        }
      },
      "AuditChainCheck": {
        "type": "object",
        "description": "One verification of the chain the duty platform.audit-verify recorded.",
        "required": [
          "status",
          "fromSeq",
          "throughSeq",
          "headSeq",
          "headHash",
          "breakSeq",
          "breakReason",
          "checkedAt"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "INTACT",
              "BROKEN"
            ],
            "description": "The verdict"
          },
          "fromSeq": {
            "type": "integer",
            "description": "The first link it verified (1 = the whole chain)"
          },
          "throughSeq": {
            "type": "integer",
            "description": "The last link it verified; 0 for an empty chain"
          },
          "headSeq": {
            "type": "integer",
            "description": "The chain's head when it ran"
          },
          "headHash": {
            "type": [
              "string",
              "null"
            ],
            "description": "The head's hash when it ran (also logged by the duty, a witness outside the database)",
            "pattern": "^[0-9a-f]{64}$"
          },
          "breakSeq": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The first link that did not hold; null when intact"
          },
          "breakReason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why it did not hold (AuditChainBreak.reason); null when intact"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When it ran, ISO-8601 UTC"
          }
        }
      },
      "AuditChain": {
        "type": "object",
        "description": "The hash chain of a trail: its head and its last recorded verification.",
        "required": [
          "chain",
          "headSeq",
          "headHash",
          "lastCheck"
        ],
        "properties": {
          "chain": {
            "type": "string",
            "description": "`org`, or `network:<networkId>`"
          },
          "headSeq": {
            "type": "integer",
            "description": "The newest link's seq; 0 while the chain is empty"
          },
          "headHash": {
            "type": [
              "string",
              "null"
            ],
            "description": "The newest link's hash; null while the chain is empty",
            "pattern": "^[0-9a-f]{64}$"
          },
          "lastCheck": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuditChainCheck"
              },
              {
                "type": "null"
              }
            ],
            "description": "The newest verification; null while none ran"
          }
        }
      },
      "AuditChainVerification": {
        "type": "object",
        "description": "A verification of one segment of the chain, computed now and recorded nowhere.",
        "required": [
          "chain",
          "intact",
          "checkedFromSeq",
          "checkedThroughSeq",
          "nextFromSeq",
          "firstBreak",
          "headSeq",
          "headHash"
        ],
        "properties": {
          "chain": {
            "type": "string",
            "description": "`org`, or `network:<networkId>`"
          },
          "intact": {
            "type": "boolean",
            "description": "Whether every link of the segment holds (and, from seq 1, the genesis seal)"
          },
          "checkedFromSeq": {
            "type": "integer",
            "description": "The first seq verified"
          },
          "checkedThroughSeq": {
            "type": "integer",
            "description": "The last seq verified without a break"
          },
          "nextFromSeq": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Where the next segment starts; null at the head or at a break"
          },
          "firstBreak": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuditChainBreak"
              },
              {
                "type": "null"
              }
            ],
            "description": "The first link that does not hold; null when intact"
          },
          "headSeq": {
            "type": "integer",
            "description": "The chain's head now"
          },
          "headHash": {
            "type": [
              "string",
              "null"
            ],
            "description": "The head's hash now",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 7807 problem details. Branch on `code`, never on `title` or `detail`.",
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "code",
          "requestId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "`urn:das:problem:<code>`"
          },
          "title": {
            "type": "string",
            "description": "Short summary of the problem type"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code"
          },
          "detail": {
            "type": "string",
            "description": "Explanation of this occurrence"
          },
          "instance": {
            "type": "string",
            "description": "The request path"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "MALFORMED_JSON",
              "INVALID_CURSOR",
              "IDEMPOTENCY_KEY_REQUIRED",
              "IDEMPOTENCY_KEY_INVALID",
              "UNAUTHENTICATED",
              "INVALID_CREDENTIAL",
              "CREDENTIAL_REVOKED",
              "CREDENTIAL_EXPIRED",
              "NO_ACCESS",
              "INSUFFICIENT_ROLE",
              "INSUFFICIENT_SCOPE",
              "ORG_CREDENTIAL_REQUIRED",
              "NETWORK_CREDENTIAL_REQUIRED",
              "NETWORK_HOST_MISMATCH",
              "FEATURE_DISABLED",
              "NOT_FOUND",
              "PATH_NOT_CANONICAL",
              "IDEMPOTENCY_CONFLICT",
              "SLUG_TAKEN",
              "NETWORK_CODE_TAKEN",
              "ALREADY_EXISTS",
              "LAST_OWNER",
              "IN_USE",
              "IDENTITY_PROVIDER_EXISTS",
              "LOCKOUT",
              "STEP_NOT_CURRENT",
              "SELF_APPROVAL",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "EMAIL_REJECTED",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "UPSTREAM_UNAVAILABLE",
              "NOT_CONFIGURED"
            ],
            "description": "Machine-readable problem code"
          },
          "requestId": {
            "type": "string",
            "description": "The request id (X-Request-Id)"
          },
          "errors": {
            "type": "array",
            "description": "Field errors of a `VALIDATION_FAILED` problem",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            }
          }
        }
      },
      "ProblemFieldError": {
        "type": "object",
        "description": "One invalid value",
        "required": [
          "location",
          "path",
          "message"
        ],
        "properties": {
          "location": {
            "type": "string",
            "enum": [
              "BODY",
              "QUERY",
              "PATH",
              "HEADER"
            ],
            "description": "Where the value was sent"
          },
          "path": {
            "type": "string",
            "description": "Dotted path inside the location; empty for the whole value"
          },
          "message": {
            "type": "string",
            "description": "What is wrong"
          }
        }
      },
      "NextCursor": {
        "type": [
          "string",
          "null"
        ],
        "description": "Cursor of the next page, opaque; null on the last page."
      },
      "Health": {
        "type": "object",
        "description": "Liveness of the process",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OK"
            ],
            "description": "Always `OK` when the process serves requests"
          }
        }
      },
      "Session": {
        "type": "object",
        "description": "The credential, the Network it acts for and the features effectively on for that Network.",
        "required": [
          "actor",
          "role",
          "scopes",
          "network",
          "features"
        ],
        "properties": {
          "features": {
            "type": "array",
            "description": "Ids of the features effectively on for the Network (the UI shows what they own); switched in the Organisation API",
            "items": {
              "type": "string"
            }
          },
          "actor": {
            "type": "string",
            "description": "Audit-grammar actor, `human:<email>`"
          },
          "role": {
            "type": "string",
            "enum": [
              "VIEWER",
              "OPERATOR",
              "ADMIN"
            ],
            "description": "Coarse role of the credential"
          },
          "scopes": {
            "type": "array",
            "description": "Scopes `das:<product>:<resource>:<action>`",
            "items": {
              "type": "string"
            }
          },
          "network": {
            "$ref": "#/components/schemas/SessionNetwork"
          }
        }
      },
      "SessionNetwork": {
        "type": "object",
        "description": "The credential's Network, as the Organisation API records it.",
        "required": [
          "id",
          "slug",
          "displayName",
          "timezone",
          "defaultCurrency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^net_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "description": "Network id, `net_<ULID>`"
          },
          "slug": {
            "type": "string",
            "description": "Host label of the Network"
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable name"
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone where the Network's days begin; dates are shown in it"
          },
          "defaultCurrency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO-4217 code of the Network's money"
          }
        }
      }
    }
  },
